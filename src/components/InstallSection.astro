---
import Icon from "./Icon.astro";

const installHref = "https://github.com/kostyrko/trailroam-for-strava#install";
const githubHref = "https://github.com/kostyrko/trailroam-for-strava";

const steps = [
  { n: 1, title: "Install & Pin", text: "Click the Extensions icon in Chrome, then pin Trailroam to your toolbar." },
  { n: 2, title: "Open the App", text: "Click the Trailroam extension icon to open the full app page." },
  { n: 3, title: "Sync Activities", text: "Sync your activities from Strava — routes, terrain, and stats appear on the map." },
  { n: 4, title: "Explore & Plan", text: "Export routes, explore trails, and plan your next adventure." },
];
---

<section class="install" id="install">
  <div class="container">
    <header class="install__head">
      <p class="eyebrow">Get started</p>
      <h2>Up and running in under a minute</h2>
      <p class="install__lead">
        Load the extension in Chrome and sign in to Strava — that's it. No accounts, no API keys,
        no servers.
      </p>
    </header>

    <div class="install__cta">
      <a class="install__btn" href={installHref} target="_blank" rel="noopener">
        <Icon name="download" size={20} />
        Install for Chrome
      </a>
      <a class="install__link" href={githubHref} target="_blank" rel="noopener">
        <Icon name="github" size={18} />
        View source on GitHub
      </a>
    </div>

    <ol class="install__grid">
      {steps.map((s) => (
        <li class="step">
          <span class="step__num">Step {s.n}</span>
          <h3 class="step__title">{s.title}</h3>
          <p class="step__text">{s.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .install {
    background: var(--c-surface);
    border-top: 1px solid var(--c-border);
    border-bottom: 1px solid var(--c-border);
  }
  .install__head {
    text-align: center;
    max-width: 640px;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .install__head h2 {
    font-size: clamp(1.6rem, 3.4vw, 2.2rem);
  }
  .install__lead {
    color: var(--c-muted);
    font-size: 1.05rem;
  }
  .install__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    justify-content: center;
    align-items: center;
    margin-top: 24px;
    margin-bottom: 48px;
  }
  .install__btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--c-green);
    color: #fff;
    font-weight: 600;
    padding: 12px 22px;
    border-radius: 999px;
    transition: background 0.15s ease, transform 0.12s ease;
  }
  .install__btn:hover {
    background: var(--c-green-dark);
    color: #fff;
    text-decoration: none;
    transform: translateY(-1px);
  }
  .install__link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--c-muted);
    font-weight: 500;
  }
  .install__link:hover {
    text-decoration: underline;
  }

  .install__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    counter-reset: step;
  }
  .step {
    background: var(--c-bg);
    border: 1px solid var(--c-border);
    border-radius: var(--radius-sm);
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    text-align: center;
  }
  .step__num {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--c-green);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .step__title {
    font-size: 1rem;
    color: var(--c-ink);
  }
  .step__text {
    font-size: 0.875rem;
    color: var(--c-muted);
    line-height: 1.5;
  }

  @media (max-width: 820px) {
    .install__grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 480px) {
    .install__grid { grid-template-columns: 1fr; }
  }
</style>
