---
import Icon from "./Icon.astro";

export interface Props {
  icon: "lock" | "map" | "sync" | "filter" | "route" | "share";
  eyebrow: string;
  title: string;
  body: string;
  bullets: string[];
  image: string;
  alt: string;
  /** reverse the row order (text/image alternation) */
  flip?: boolean;
}

const { icon, eyebrow, title, body, bullets, image, alt, flip = false } = Astro.props;
---

<section class={`slide ${flip ? "slide--flip" : ""}`}>
  <div class="slide__media">
    <img src={image} alt={alt} loading="lazy" />
  </div>
  <div class="slide__copy">
    <span class="slide__icon"><Icon name={icon} size={24} /></span>
    <p class="eyebrow">{eyebrow}</p>
    <h2>{title}</h2>
    <p class="slide__body">{body}</p>
    <ul>
      {bullets.map((b) => <li>{b}</li>)}
    </ul>
  </div>
</section>

<style>
  .slide {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: clamp(32px, 5vw, 64px);
    align-items: center;
    padding-block: clamp(40px, 6vw, 72px);
  }
  .slide--flip .slide__media {
    order: 2;
  }

  .slide__media {
    background: var(--c-surface);
    border: 1px solid var(--c-border);
    border-radius: var(--radius);
    box-shadow: var(--shadow-card);
    overflow: hidden;
  }
  .slide__media img {
    width: 100%;
    display: block;
  }

  .slide__copy {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .slide__icon {
    display: inline-flex;
    width: 44px;
    height: 44px;
    align-items: center;
    justify-content: center;
    border-radius: 12px;
    background: rgba(31, 111, 80, 0.1);
    color: var(--c-green);
    margin-bottom: 4px;
  }
  .slide__copy h2 {
    font-size: clamp(1.5rem, 3vw, 2rem);
  }
  .slide__body {
    color: var(--c-muted);
    font-size: 1.05rem;
    max-width: 46ch;
  }
  .slide__copy ul {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-top: 6px;
  }
  .slide__copy li {
    position: relative;
    padding-left: 22px;
    color: var(--c-ink);
  }
  .slide__copy li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--c-green);
  }

  @media (max-width: 820px) {
    .slide {
      grid-template-columns: 1fr;
      gap: 24px;
    }
    .slide--flip .slide__media {
      order: 0;
    }
  }
</style>
